{
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "description": "__MSG_extDescription__",
   "version": "0.9.1",
   "default_locale": "en",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "icons": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
   },
   "action": {
      "default_popup": "src/popup/popup.html",
      "default_icon": {
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "96": "icons/icon96.png",
         "128": "icons/icon128.png"
      }
   },
   "background": {
      "service_worker": "service-worker.js"
   },
   "content_scripts": [ {
      "matches": [ "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.live.com/*", "https://*.teams.live.com/*", "https://teams.cloud.microsoft/*", "https://*.teams.cloud.microsoft/*", "https://*.mcas.ms/*" ],
      "js": [
         "src/shared/util.js",
         "src/content/runtime.js",
         "src/content/dom.js",
         "src/content/session.js",
         "src/content/richtext.js",
         "src/content/attachments.js",
         "src/content/reactions.js",
         "src/content/conversation.js",
         "src/content/chat.js",
         "src/content/channel.js",
         "src/content/main.js"
      ],
      "run_at": "document_end"
   } ],
   "permissions": [ "activeTab", "scripting", "storage", "downloads" ],
   "host_permissions": [ "https://teams.microsoft.com/*", "https://*.teams.microsoft.com/*", "https://teams.live.com/*", "https://*.teams.live.com/*", "https://teams.cloud.microsoft/*", "https://*.teams.cloud.microsoft/*", "https://*.sharepoint.com/*", "https://*.sharepoint-df.com/*", "https://1drv.ms/*", "https://*.1drv.ms/*", "https://*.asm.skype.com/*", "https://*.asyncgw.teams.microsoft.com/*", "https://*.mcas.ms/*" ]
}
